package pages

import (
	"go-templ-mock-1/components/avatar"
	"go-templ-mock-1/components/badge"
	"go-templ-mock-1/components/card"
	"go-templ-mock-1/components/table"
	"go-templ-mock-1/layouts"
)

type Invoice struct {
	ID, Status, Method, Amount string
}

var invoices = []Invoice{
	{"INV001", "Paid", "Credit Card", "$250.00"},
	{"INV002", "Pending", "PayPal", "$150.00"},
	{"INV003", "Unpaid", "Bank Transfer", "$350.00"},
	{"INV004", "Paid", "Credit Card", "$450.00"},
}

func statusVariant(s string) badge.Variant {
	switch s {
	case "Paid":
		return badge.VariantDefault
	case "Pending":
		return badge.VariantSecondary
	}
	return badge.VariantDestructive
}

templ Data() {
	@layouts.Shell("Data", "/data") {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Team
				}
			}
			@card.Content() {
				@avatar.Group() {
					@avatar.Avatar() {
						@avatar.Fallback() {
							AH
						}
					}
					@avatar.Avatar() {
						@avatar.Fallback() {
							JD
						}
					}
					@avatar.Avatar() {
						@avatar.Fallback() {
							AX
						}
					}
				}
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Invoices
				}
				@card.Description() {
					A list of recent invoices.
				}
			}
			@card.Content() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								Invoice
							}
							@table.Head() {
								Status
							}
							@table.Head() {
								Method
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Amount
							}
						}
					}
					@table.Body() {
						for _, inv := range invoices {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "font-medium"}) {
									{ inv.ID }
								}
								@table.Cell() {
									@badge.Badge(badge.Props{Variant: statusVariant(inv.Status)}) {
										{ inv.Status }
									}
								}
								@table.Cell() {
									{ inv.Method }
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									{ inv.Amount }
								}
							}
						}
					}
				}
			}
		}
	}
}
