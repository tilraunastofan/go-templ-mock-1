package pages

import (
	"fmt"
	"strconv"

	"go-templ-mock-1/components/badge"
	"go-templ-mock-1/components/button"
	"go-templ-mock-1/components/card"
	"go-templ-mock-1/components/input"
	"go-templ-mock-1/components/table"
	"go-templ-mock-1/layouts"
)

templ Search() {
	@layouts.Shell("Search", "/search") {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Search people
				}
				@card.Description() {
					Type to search a mock dataset of 200 people (name, email, role, department, city, status). Each keystroke fetches only the results fragment with HTMX.
				}
			}
			@card.Content() {
				// Alpine owns the client-side state (selection, compact toggle).
				// It lives on this parent, which htmx never swaps, so it survives
				// every new search; swapped-in rows just bind to it.
				<div class="space-y-4" x-data="{ selected: [], compact: false }">
					@input.Input(input.Props{
						Type:        "search",
						Name:        "q",
						Placeholder: "Try \"berlin\", \"sre\" or \"ada\"...",
						Attributes: templ.Attributes{
							"hx-get":     "/search/results",
							"hx-trigger": "input changed delay:250ms, search",
							"hx-target":  "#search-results",
							"hx-swap":    "innerHTML",
						},
					})
					<div class="flex items-center gap-4 text-sm">
						<label class="flex items-center gap-2">
							<input type="checkbox" x-model="compact"/>
							Compact rows
						</label>
						<span class="text-muted-foreground" x-text="selected.length + ' selected'"></span>
						<span x-show="selected.length" x-cloak>
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"type": "button", "@click": "selected = []"}}) {
								Clear selection
							}
						</span>
					</div>
					<div id="search-results" :class="compact && 'text-xs [&_td]:py-1'">
						@SearchResults(SearchPeople(""))
					</div>
				</div>
			}
		}
	}
}

// SearchResults is the HTMX fragment swapped into #search-results.
templ SearchResults(results []Person, total int) {
	<p class="mb-2 text-sm text-muted-foreground">
		if total == 0 {
			No matches.
		} else if total > len(results) {
			{ fmt.Sprintf("Showing %d of %d matches.", len(results), total) }
		} else if total == 1 {
			1 match.
		} else {
			{ fmt.Sprintf("%d matches.", total) }
		}
	</p>
	if total > 0 {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						<span class="sr-only">Select</span>
					}
					@table.Head() {
						Name
					}
					@table.Head() {
						Role
					}
					@table.Head() {
						Department
					}
					@table.Head() {
						City
					}
					@table.Head() {
						Status
					}
				}
			}
			@table.Body() {
				for _, p := range results {
					@table.Row(table.RowProps{Attributes: templ.Attributes{":data-state": fmt.Sprintf("selected.includes('%d') ? 'selected' : ''", p.ID)}}) {
						@table.Cell() {
							<input type="checkbox" value={ strconv.Itoa(p.ID) } x-model="selected" aria-label={ "Select " + p.Name }/>
						}
						@table.Cell() {
							<div class="font-medium">{ p.Name }</div>
							<div class="text-xs text-muted-foreground">{ p.Email }</div>
						}
						@table.Cell() {
							{ p.Role }
						}
						@table.Cell() {
							{ p.Department }
						}
						@table.Cell() {
							{ p.City }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{Variant: personStatusVariant(p.Status)}) {
								{ p.Status }
							}
						}
					}
				}
			}
		}
	}
}

func personStatusVariant(status string) badge.Variant {
	if status == "active" {
		return badge.VariantDefault
	}
	return badge.VariantSecondary
}
