package pages

import (
	"go-templ-mock-1/components/badge"
	"go-templ-mock-1/components/button"
	"go-templ-mock-1/components/card"
	"go-templ-mock-1/components/input"
	"go-templ-mock-1/components/label"
	selectcomp "go-templ-mock-1/components/select"
	"go-templ-mock-1/layouts"
)

// fontPair is one trial combination. Sans/Heading/Mono are CSS font-family
// values; Bunny is the fonts.bunny.net query that loads them ("" = system).
type fontPair struct {
	ID, Name, Sans, Heading, Mono, Bunny, Group string
}

const (
	systemSans = `ui-sans-serif, system-ui, sans-serif`
	systemMono = `ui-monospace, SFMono-Regular, Menlo, monospace`
)

var fontPairs = []fontPair{
	{"system", "System", systemSans, systemSans, systemMono, "", "Sans"},
	{"geist", "Geist", `"Geist", ` + systemSans, `"Geist", ` + systemSans, `"Geist Mono", ` + systemMono, "geist:400,500,600,700|geist-mono:400,500", "Sans"},
	{"inter", "Inter + JetBrains Mono", `"Inter", ` + systemSans, `"Inter", ` + systemSans, `"JetBrains Mono", ` + systemMono, "inter:400,500,600,700|jetbrains-mono:400,500", "Sans"},
	{"dm-sans", "DM Sans", `"DM Sans", ` + systemSans, `"DM Sans", ` + systemSans, systemMono, "dm-sans:400,500,700", "Sans"},
	{"fraunces", "Fraunces headings + Inter", `"Inter", ` + systemSans, `"Fraunces", ui-serif, Georgia, serif`, `"JetBrains Mono", ` + systemMono, "fraunces:600,700|inter:400,500,600,700|jetbrains-mono:400,500", "Mixed pairings"},
	{"plex", "IBM Plex", `"IBM Plex Sans", ` + systemSans, `"IBM Plex Sans", ` + systemSans, `"IBM Plex Mono", ` + systemMono, "ibm-plex-sans:400,500,600|ibm-plex-mono:400,500", "Sans"},
	{"grotesk", "Space Grotesk headings + Plex", `"IBM Plex Sans", ` + systemSans, `"Space Grotesk", ` + systemSans, `"IBM Plex Mono", ` + systemMono, "space-grotesk:500,700|ibm-plex-sans:400,500,600|ibm-plex-mono:400,500", "Mixed pairings"},
	{"newsreader", "Newsreader (serif)", `"Newsreader", ui-serif, Georgia, serif`, `"Newsreader", ui-serif, Georgia, serif`, systemMono, "newsreader:400,600", "Serif"},
	{"instrument", "Instrument Sans + DM Mono", `"Instrument Sans", ` + systemSans, `"Instrument Sans", ` + systemSans, `"DM Mono", ` + systemMono, "instrument-sans:400,500,600,700|dm-mono:400,500", "Sans"},
	{"onest", "Onest", `"Onest", ` + systemSans, `"Onest", ` + systemSans, systemMono, "onest:400,500,600,700", "Sans"},
	{"schibsted", "Schibsted Grotesk", `"Schibsted Grotesk", ` + systemSans, `"Schibsted Grotesk", ` + systemSans, systemMono, "schibsted-grotesk:400,500,600,700", "Sans"},
	{"manrope", "Manrope + Source Code Pro", `"Manrope", ` + systemSans, `"Manrope", ` + systemSans, `"Source Code Pro", ` + systemMono, "manrope:400,500,600,700|source-code-pro:400,500", "Sans"},
	{"jakarta", "Plus Jakarta Sans", `"Plus Jakarta Sans", ` + systemSans, `"Plus Jakarta Sans", ` + systemSans, systemMono, "plus-jakarta-sans:400,500,600,700", "Sans"},
	{"figtree", "Figtree + Fira Code", `"Figtree", ` + systemSans, `"Figtree", ` + systemSans, `"Fira Code", ` + systemMono, "figtree:400,500,600,700|fira-code:400,500", "Sans"},
	{"inter-tight", "Inter Tight", `"Inter Tight", ` + systemSans, `"Inter Tight", ` + systemSans, systemMono, "inter-tight:400,500,600", "Sans"},
	{"work-sans", "Work Sans", `"Work Sans", ` + systemSans, `"Work Sans", ` + systemSans, systemMono, "work-sans:400,500,600", "Sans"},
	{"outfit", "Outfit headings + Public Sans", `"Public Sans", ` + systemSans, `"Outfit", ` + systemSans, systemMono, "outfit:400,500,600|public-sans:400,500,600", "Mixed pairings"},
	{"sora", "Sora headings + Inter", `"Inter", ` + systemSans, `"Sora", ` + systemSans, `"Space Mono", ` + systemMono, "sora:400,500,600|inter:400,500,600,700|space-mono:400", "Mixed pairings"},
	{"playfair", "Playfair Display headings + Source Serif", `"Source Serif 4", ui-serif, Georgia, serif`, `"Playfair Display", ui-serif, Georgia, serif`, systemMono, "playfair-display:600,700|source-serif-4:400,600", "Serif"},
	{"lora", "Lora (serif) + Inter headings", `"Lora", ui-serif, Georgia, serif`, `"Inter", ` + systemSans, systemMono, "lora:400,600|inter:400,500,600,700", "Mixed pairings"},
}

// fontScript applies a pair by overriding the Tailwind --font-sans/--font-mono
// variables on <html> (so the whole page, nav included, changes) and lazily
// loads the pair's families from Bunny Fonts. The choice is kept in localStorage.
const fontScript = `(function () {
	var root = document.documentElement;
	var loaded = {};
	function item(id) { return document.querySelector('[data-font-pair="' + id + '"]'); }
	function load(query) {
		if (!query || loaded[query]) return;
		loaded[query] = true;
		var link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = 'https://fonts.bunny.net/css?display=swap&family=' + query;
		document.head.appendChild(link);
	}
	function apply(el) {
		load(el.dataset.bunny);
		root.style.setProperty('--font-sans', el.dataset.sans);
		root.style.setProperty('--font-mono', el.dataset.mono);
		root.style.setProperty('--demo-heading', el.dataset.heading);
		document.getElementById('font-current').textContent = el.dataset.name;
		try { localStorage.setItem('fontPair', el.dataset.fontPair); } catch (e) {}
	}
	document.addEventListener('select-change', function (e) {
		if (e.target.id !== 'font-select-trigger') return;
		var el = item(e.detail.value);
		if (el) apply(el);
	});
	var saved = null;
	try { saved = localStorage.getItem('fontPair'); } catch (e) {}
	var el = saved && item(saved);
	apply(el || item('system'));
	// The select's own script isn't ready until load; clicking the item then
	// commits it to the select (trigger label) and re-fires select-change.
	if (el && saved !== 'system') {
		var sync = function () { el.click(); };
		if (document.readyState === 'complete') sync();
		else window.addEventListener('load', sync);
	}
})();`

const codeSample = `func main() {
	mux := http.NewServeMux()
	mux.Handle("GET /", templ.Handler(Home()))
	// 0O 1lI {} [] => != === ->
}`

// noAlign opens the select below the trigger like a dropdown.
var noAlign = false

// fontGroups lists the group labels in display order.
var fontGroups = []string{"Sans", "Mixed pairings", "Serif"}

func fontItems() []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, len(fontPairs))
	for i, p := range fontPairs {
		items[i] = selectcomp.ItemData{Value: p.ID, Label: p.Name}
	}
	return items
}

func pairAttrs(p fontPair) templ.Attributes {
	return templ.Attributes{
		"data-font-pair": p.ID,
		"data-name":      p.Name,
		"data-sans":      p.Sans,
		"data-heading":   p.Heading,
		"data-mono":      p.Mono,
		"data-bunny":     p.Bunny,
	}
}

templ Typography() {
	@layouts.Shell("Typography", "/typography") {
		<div class="space-y-3">
			<div class="flex items-baseline justify-between gap-4">
				<h1 class="text-3xl font-semibold tracking-tight [font-family:var(--demo-heading,var(--font-sans))]">Typography</h1>
				<p class="text-sm text-muted-foreground">Current: <span id="font-current" class="font-medium text-foreground">System</span></p>
			</div>
			<p class="text-muted-foreground">
				Pick a pair from the dropdown to swap the font for the whole page, nav included. Fonts load on demand from Bunny Fonts and your choice is remembered in this browser.
			</p>
			@selectcomp.Select(selectcomp.Props{ID: "font-select", Items: fontItems(), DefaultValue: "system"}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{ID: "font-select-trigger", Class: "w-[320px] max-w-full", Attributes: templ.Attributes{"aria-label": "Font pair"}}) {
					@selectcomp.Value()
				}
				@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: &noAlign}) {
					for i, grp := range fontGroups {
						if i > 0 {
							@selectcomp.Separator()
						}
						@selectcomp.Group() {
							@selectcomp.Label() {
								{ grp }
							}
							for _, p := range fontPairs {
								if p.Group == grp {
									@selectcomp.Item(selectcomp.ItemProps{Value: p.ID, Attributes: pairAttrs(p)}) {
										{ p.Name }
									}
								}
							}
						}
					}
				}
			}
		</div>
		<div class="grid gap-6 md:grid-cols-2">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Type scale
					}
					@card.Description() {
						Headings use the pair's heading face, body text the sans face.
					}
				}
				@card.Content() {
					<div class="space-y-3 [&_h2,&_h3,&_h4]:[font-family:var(--demo-heading,var(--font-sans))]">
						<h2 class="text-4xl font-bold tracking-tight">Deploy with confidence</h2>
						<h3 class="text-2xl font-semibold">Ship to production</h3>
						<h4 class="text-xl font-semibold">Release notes</h4>
						<p>
							Body text at the base size. The quick brown fox jumps over the lazy dog, then promotes build 4.12.0 from test to prod without a single failing check.
						</p>
						<p class="text-sm text-muted-foreground">
							Small muted text for descriptions and hints. 0123456789 — Illegal 1lI | O0 | rn m.
						</p>
						<p class="text-xs uppercase tracking-wider text-muted-foreground">Overline label</p>
						<p class="italic">Italic emphasis and <strong>strong text</strong> sit next to regular weight.</p>
					</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Numbers &amp; code
					}
					@card.Description() {
						Tabular figures and the mono face.
					}
				}
				@card.Content() {
					<div class="space-y-3">
						<table class="w-full text-sm tabular-nums">
							<thead>
								<tr class="border-b text-left text-muted-foreground">
									<th class="py-1 font-medium">Service</th>
									<th class="py-1 text-right font-medium">Requests</th>
									<th class="py-1 text-right font-medium">p95</th>
								</tr>
							</thead>
							<tbody>
								<tr class="border-b"><td class="py-1">api-gateway</td><td class="py-1 text-right">1,284,019</td><td class="py-1 text-right">112 ms</td></tr>
								<tr class="border-b"><td class="py-1">billing</td><td class="py-1 text-right">48,201</td><td class="py-1 text-right">340 ms</td></tr>
								<tr><td class="py-1">search</td><td class="py-1 text-right">9,877</td><td class="py-1 text-right">88 ms</td></tr>
							</tbody>
						</table>
						<pre class="overflow-x-auto rounded-md bg-muted p-3 font-mono text-sm"><code>{ codeSample }</code></pre>
						<p class="text-sm">Inline <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.9em]">go tool templ generate</code> in a sentence.</p>
					</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Form controls
					}
					@card.Description() {
						Inputs, buttons and badges inherit the font.
					}
				}
				@card.Content() {
					<form class="space-y-3" onsubmit="return false">
						<div class="space-y-1.5">
							@label.Label(label.Props{For: "ty-name"}) {
								Project name
							}
							@input.Input(input.Props{ID: "ty-name", Placeholder: "payments-service"})
						</div>
						<div class="flex flex-wrap items-center gap-2">
							@button.Button() {
								Primary
							}
							@button.Button(button.Props{Variant: button.VariantSecondary}) {
								Secondary
							}
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								Outline
							}
							@badge.Badge() {
								v4.12.0
							}
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								healthy
							}
						</div>
					</form>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Long-form reading
					}
					@card.Description() {
						A paragraph block to judge rhythm and line length.
					}
				}
				@card.Content() {
					<div class="space-y-3 leading-relaxed">
						<p>
							Platform teams spend much of their day reading: dashboards, incident timelines, diffs and runbooks. A typeface for this kind of work has to stay legible at small sizes, keep numerals aligned and distinguish similar glyphs without effort.
						</p>
						<p>
							Try each pair at your normal zoom level, then in dark mode. Pay attention to the weight of 500 and 600 text, which is where many fonts look noticeably different.
						</p>
					</div>
				}
			}
		</div>
		@templ.Raw("<script>" + fontScript + "</script>")
	}
}
