package pages

import (
	"go-templ-mock-1/components/alert"
	"go-templ-mock-1/components/badge"
	"go-templ-mock-1/components/button"
	"go-templ-mock-1/components/card"
	"go-templ-mock-1/components/progress"
	"go-templ-mock-1/components/skeleton"
	"go-templ-mock-1/components/spinner"
	"go-templ-mock-1/layouts"
)

templ Feedback() {
	@layouts.Shell("Feedback", "/feedback") {
		@alert.Alert() {
			@alert.Title() {
				Heads up!
			}
			@alert.Description() {
				You can add components to your app with the shadcn-templ CLI.
			}
		}
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
			@alert.Title() {
				Something went wrong
			}
			@alert.Description() {
				Your session has expired. Please sign in again.
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Badges
				}
			}
			@card.Content() {
				<div class="flex flex-wrap gap-2">
					@badge.Badge() {
						Default
					}
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						Secondary
					}
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						Outline
					}
					@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
						Destructive
					}
				</div>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Loading states
				}
				@card.Description() {
					Click the button to load a fragment with HTMX (takes ~1s).
				}
			}
			@card.Content() {
				<div class="space-y-4">
					@progress.Progress(progress.Props{Value: 60})
					<div class="flex items-center gap-4">
						@skeleton.Skeleton(skeleton.Props{Class: "size-12 rounded-full"})
						<div class="space-y-2">
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-[250px]"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-[200px]"})
						</div>
					</div>
					<div class="flex items-center gap-3">
						@button.Button(button.Props{Attributes: templ.Attributes{"hx-get": "/feedback/slow", "hx-target": "#slow-result", "hx-indicator": "#slow-spinner"}}) {
							Load data
						}
						<span id="slow-spinner" class="opacity-0 transition-opacity [&.htmx-request]:opacity-100">
							@spinner.Spinner()
						</span>
						<div id="slow-result" class="text-sm"></div>
					</div>
				</div>
			}
		}
	}
}

templ SlowResult(msg string) {
	@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
		{ msg }
	}
}
